# Bu dosya örnektir; gerçek değer içermez.
# Kopyalayın:  cp .env.example .env.local
# .env.local dosyası git'e gönderilmez.

# --- Demo yapılandırması ---
DEMO_MODE=true
DATA_PROVIDER=sqlite
IMAGE_PROVIDER=local

# Canlı demo (Netlify) kilidi.
# true iken: veritabanı salt-okunur açılır, açılış yazımları (migration/seed)
# çalışmaz ve tüm yazma uçları 403 döner. YEREL GELİŞTİRMEDE BOŞ BIRAKIN.
DEMO_READ_ONLY=

# --- Panel yöneticisi ---
# Parolanın kendisi değil, yalnızca bcrypt hash'i saklanır.
# Hash üretmek için:  npm run admin:create-password
#
# ÖNEMLİ: Hash içindeki "$" karakterlerini \$ olarak kaçırın. Kaçış olmadan
# Next.js .env okurken "$2b" ifadesini değişken sanar ve hash bozulur:
#   DOĞRU : ADMIN_PASSWORD_HASH='\$2b\$12\$abc...'
#   YANLIŞ: ADMIN_PASSWORD_HASH='$2b$12$abc...'
# "npm run admin:create-password" bu kaçışı otomatik uygular.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Oturum imzalama anahtarı (en az 32 karakter, rastgele).
# Üretmek için:  node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Depolama ---
SQLITE_DATABASE_PATH=./data/pastamarket.db
LOCAL_UPLOAD_DIR=./public/uploads
